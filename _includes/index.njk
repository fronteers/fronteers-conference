{% extends "_includes/default.njk" %}
{% block content %}
  {% include '_partials/announcer.njk' %}

  <section class="narrow-width">
    <h3 class="headline">About Fronteers Dark Mode</h3>
    <p>
      Fronteers Dark Mode is a ~ 100 people, cozy, single-track after-work front-end conference by and for the community.
      Taking place on Friday, October 2nd, 2026 at the atmospheric <a href="/venue">Cinema De Witt</a> in <a href="/dordrecht">Dordrecht</a>, it offers an evening of <a href="/schedule">inspiring talks</a> on the material of the web, HTML, CSS, JS &ndash; and a nerdy late-night finale.
    </p>
  </section>

  {% include '_partials/cta.njk' %}

  {% set items = collections.speakers %}
  {% if items | length %}
    <section class="narrow-width">
      <ul class="cards full-width">
        {% asyncEach item in items|sortByAlphabet %}
        <li class="cards__item">
          {% set href = item.url %}
          {% set src = item.data.image %}
          {% set alt = '' %}
          {% if item.data.alt %}
            {% set alt = item.data.alt %}
          {% endif %}
          {% set headline = item.data.title %}
          {% set text = item.data.talktitle %}
          <figure class="card --speaker">
            {% image src, alt, '9.375rem', 'lazy' %}
            <figcaption class="card__caption">
              <a href="{{ href }}" class="card__link">
                <h3 class="card__headline headline">{{ headline }}</h3>
                <p class="card__text">{{ text|safe }}</p>
              </a>
            </figcaption>
          </figure>
        </li>
        {% endeach %}
      </ul>
    </section>
  {% endif %}

  {% set src = '/img/venue.jpg' %}
  {% set alt = 'Evening view of a lively courtyard outside a modern glass-fronted venue. String lights hang between large trees while groups of people sit and socialize at outdoor tables surrounded by colourful plants and flower beds.' %}
  {% include '_partials/hero.njk' %}


  <section class="narrow-width" aria-labelledby="accessibility">
    <h2 id="accessibility">Accessibility</h2>
    <p>
      The cinema and brasserie are fully wheelchair accessible.
      The building has step-free access throughout, includes a lift, and offers an accessible toilet on the ground floor.
      Please reach out to <a href="mailto:conference@fronteers.nl">conference@fronteers.nl</a> if you have further accessibility related questions or requests.
    </p>
  </section>

  {% include '_partials/json-ld.njk' %}
{% endblock %}
